source_unit
  : ("pragma" solidity_version "\n")? contract_item*

contract_item
  : function_def
  | var_decl
  | event_decl
  | ";"*

function_def
  : (visibility)? "function" identifier "(" (parameter ("," parameter)*)? ")" ("returns" "(" type_name ("," type_name)? ")")? "{" block "}"

visibility
  : "public" | "internal" | "private"

parameter
  : type_name identifier (":" type_name)?

var_decl
  : (type_name | ("mapping" "<" type_name "," type_name ">") ) identifier ("=" expression)?

event_decl
  : "event" identifier "(" (event_param ("," event_param)*)? ")" ";"

event_param
  : type_name identifier ("indexed")?

block
  : "{" (statement)* "}"

statement
  : for_statement
  | while_statement
  | if_statement
  | expression_statement
  | "return" (expression)? ";"
  | "emitevent" identifier "(" (expression ("," expression)*)? ")" ";"
  | "assert" "(" expression "," string_literal? ")";"

for_statement
  : "for" "(" (expression? ":" expression?)? ";" expression? ";" (expression)? ")" block

while_statement
  : "while" "(" expression ")" block

if_statement
  : "if" "(" expression ")" block ("else" block)?

expression_statement
  : expression ";"

expression
  : logical_or

logical_or
  : logical_and ("or" logical_and)*

logical_and
  : equality ("and" equality)*

equality
  : comparison ("==" comparison | "!=" comparison)*

comparison
  : term ("<" term | "<=" term | ">" term | ">=" term)*

term
  : factor ("*" factor | "/" factor | "%" factor)*

factor
  : unary ("**" unary)?

unary
  : ("-" | "!")? unary primary
  | primary

primary
  : number_lit
  | address_lit
  | string_lit
  | identifier
  | "(" expression ")"
  | primary "(" args? ")"

args
  : (expression ("," expression)*)?

identifier
  : /[a-zA-Z_][a-zA-Z0-9_]*/

number_lit
  : /[0-9]+/

address_lit
  : "0x" /[0-9a-fA-F]{40}/

string_lit
  : "\"" /([^"\n\\]|\\.)*("\""/

type_name
  : "address" | "uint" | "int" | "bool" | "string" | "bytes"

modifier
  : "pure" | "view" | "payable" | "virtual" | "override"

source_unit
  : (Pragma)? (Import)? contract_item*

Pragma
  : "pragma" solidity_version

solidity_version
  : "0." /[0-9]+/ "." /[0-9]+/

Import
  : "import" string_lit ";"
